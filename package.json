{
  "name": "@workglow/sec",
  "type": "module",
  "version": "0.0.9",
  "description": "Workglow SEC is an example of using the Workglow AI library to build a tool for retrieving SEC data.",
  "scripts": {
    "bunset": "bunset --patch --push",
    "release": "bun run build && bun run test && bun run bunset",
    "dev": "concurrently -c 'auto' -n 'sec:' 'bun:dev-*'",
    "dev-js": "bun build --watch --target=bun --sourcemap=external --packages=external --outdir ./dist ./src/sec.ts ./src/index.ts",
    "dev-types": "tsc --watch --preserveWatchOutput",
    "build": "bun run build-clean && bun run build-js && bun run build-types",
    "build-clean": "rm -fr dist/*",
    "build-js": "bun build --target=bun --packages=external --outdir ./dist ./src/sec.ts ./src/index.ts",
    "build-types": "rm -f tsconfig.tsbuildinfo && tsc",
    "use-source": "bun ./scripts/bunsrc.ts source",
    "use-dist": "bun ./scripts/bunsrc.ts dist",
    "test": "bun test"
  },
  "bin": "./dist/sec.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@sroussey/parse-address": "^2.4.2",
    "@sroussey/parse-full-name": "^2.0.0",
    "@workglow/cli": "0.3.26",
    "awesome-phonenumber": "^7.8.0",
    "cheerio": "^1.2.0",
    "cheerio-json-mapper": "^1.0.4",
    "commander": "^15.0.0",
    "compromise": "^14.16.0",
    "csv-parse": "^6.2.1",
    "fast-xml-parser": "^5.10.0",
    "html-entities": "^2.6.0",
    "pdf2json": "^4.0.3",
    "pg": "^8.22.0",
    "typebox": "1.3.6",
    "words-to-numbers": "^1.5.1",
    "workglow": "0.3.26",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/pg": "^8.15.2",
    "@types/xml2js": "^0.4.14",
    "bunset": "1.0.13",
    "concurrently": "^10.0.3",
    "vitest": "^4.1.10"
  },
  "trustedDependencies": [
    "@huggingface/transformers",
    "onnxruntime-node"
  ],
  "private": true,
  "peerDependencies": {
    "typescript": "^6.0.3"
  }
}
